# Optional token for higher GitHub API rate limits on public repositories.
# Keep the real token in .env.local and never commit it.
GITHUB_TOKEN=

# GitHub OAuth app credentials for the private preview.
GITHUB_ID=
GITHUB_SECRET=
# Comma-separated GitHub usernames permitted to sign in.
ALLOWED_GITHUB_USERS=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# Set to the deployed HTTPS origin, e.g. https://sentinel-preview.onrender.com
NEXTAUTH_URL=

# PostgreSQL connection string for audit report history.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Server-side API keys. Never add a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# Reserved for a future provider option; not currently used.
ANTHROPIC_API_KEY=
